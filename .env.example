# Copy to `.env` and fill in. `.env` is gitignored.

# --- Tapo C100 RTSP (the "Camera Account" you set in the Tapo app) ---
CAM_USER=your-camera-account-username
CAM_PASS=your-camera-account-password
CAM_IP=192.168.x.x        # the camera's LAN IP (router device list / Tapo app / arp scan)
CAM_PATH=stream1          # stream1 = 1080p main, stream2 = low-res sub

# --- LiveKit for the M2 test ---
# Use a LOCAL `livekit-server --dev` (well-known dev keys below) OR a SEPARATE
# throwaway LiveKit Cloud project. NEVER the production project.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_ROOM=gateway-spike
LIVEKIT_IDENTITY=cam_spike01
